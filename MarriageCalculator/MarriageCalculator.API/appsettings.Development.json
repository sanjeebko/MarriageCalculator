{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server={MCDATABASE};Database=MarriageCalculator;User Id={MCUSER};Password={MCPASSWORD};TrustServerCertificate=true;MultipleActiveResultSets=true;ConnectRetryCount=3;ConnectRetryInterval=10;Connection Timeout=30;",
    "LocalSqlServer": "Server=(localdb)\\mssqllocaldb;Database=MarriageCalculatorDB;Trusted_Connection=true;MultipleActiveResultSets=true;",
    "LocalSqlServerExpress": "Server=.\\SQLEXPRESS;Database=MarriageCalculatorDB;Integrated Security=true;TrustServerCertificate=true;",
    "DockerSqlServer": "Server=localhost,1433;Database=MarriageCalculatorDB;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=true;"
  },
  "DatabaseSettings": {
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:30",
    "AutoCreateDatabase": true,
    "UseConnectionString": "DefaultConnection"
  }
}