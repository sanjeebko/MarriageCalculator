{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "MarriageCalculator.API.Services.EmailService": "Debug",
        "MarriageCalculator.API.Controllers": "Debug",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log_.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj} {NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server={MCDATABASE};Database=MarriageCalculator;User Id={MCUSER};Password={MCPASSWORD};TrustServerCertificate=true;MultipleActiveResultSets=true;ConnectRetryCount=3;ConnectRetryInterval=10;Connection Timeout=30;",
    "LocalSqlServer": "Server=(localdb)\\mssqllocaldb;Database=MarriageCalculatorDB;Trusted_Connection=true;MultipleActiveResultSets=true;",
    "LocalSqlServerExpress": "Server=.\\SQLEXPRESS;Database=MarriageCalculatorDB;Integrated Security=true;TrustServerCertificate=true;",
    "DockerSqlServer": "Server=localhost,1433;Database=MarriageCalculatorDB;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=true;"
  },
  "DatabaseSettings": {
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:30",
    "AutoCreateDatabase": true,
    "UseConnectionString": "DefaultConnection"
  },
  "Jwt": {
    "SecretKey": "YourDevelopmentSecretKeyThatShouldBeAtLeast32CharactersLong!@#DEV",
    "Issuer": "MarriageCalculator.API.Development",
    "Audience": "MarriageCalculator.Users.Development",
    "ExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 7
  },
  "Email": {
    "FromAddress": "dev-noreply@marriagecalculator.com", 
    "FromName": "Marriage Calculator (Development)"
  }
}