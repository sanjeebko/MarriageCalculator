<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MarriageCalculator.ViewModels"
             x:Class="MarriageCalculator.Pages.Login.LoginPage"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:LoginViewModel"
             Title="Login">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Seamless Gradient Background -->
        <Rectangle Grid.RowSpan="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow0}, Dark={StaticResource DarkGradientRow0}}" 
                                  Offset="0.0"/>
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow1}, Dark={StaticResource DarkGradientRow1}}" 
                                  Offset="0.4"/>
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow2}, Dark={StaticResource DarkGradientRow2}}" 
                                  Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Header Section -->
        <StackLayout Grid.Row="0" Spacing="16" Margin="24,40,24,24" BackgroundColor="Transparent">
            <!-- App Logo -->
            <Frame BackgroundColor="Transparent" 
                   BorderColor="Transparent" 
                   Padding="0"
                   HorizontalOptions="Center">
                <Frame.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,8"
                            Radius="24"
                            Opacity="0.4"/>
                </Frame.Shadow>
                <Image Source="cards.png"
                       HeightRequest="120"
                       HorizontalOptions="Center"
                       Aspect="AspectFit"/>
            </Frame>

            <!-- Welcome Text -->
            <Label Text="Welcome Back!"
                   Style="{StaticResource GameTitleLabel}"
                   FontSize="28"
                   Margin="0,8,0,0"/>
            
            <Label Text="Sign in to continue playing"
                   FontFamily="PoppinsRegular"
                   FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource GameSubtitleLight}, Dark={StaticResource GameSubtitleDark}}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Opacity="0.8"/>
        </StackLayout>

        <!-- Main Content - Login Form -->
        <ScrollView Grid.Row="1" BackgroundColor="Transparent">
            <StackLayout Spacing="24" Padding="24,0,24,40" BackgroundColor="Transparent">

                <!-- Login Form Card -->
                <Frame Style="{StaticResource GameCardFrame}" 
                       Padding="32,24">
                    <StackLayout Spacing="20">

                        <!-- Username/Email Field -->
                        <StackLayout Spacing="8">
                            <Label Text="Email or Username"
                                   FontFamily="PoppinsSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"/>
                            
                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource LightControlsBackground}, Dark={StaticResource DarkControlsBackground}}"
                                   BorderColor="Transparent"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False">
                                <Entry x:Name="UsernameEntry"
                                       Text="{Binding Username}"
                                       Placeholder="Enter your email or username"
                                       FontFamily="PoppinsRegular"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource LightControlsText}, Dark={StaticResource DarkControlsText}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}"
                                       BackgroundColor="Transparent"
                                       Keyboard="Email"
                                       ReturnType="Next"
                                       Margin="16,12"/>
                            </Frame>
                        </StackLayout>

                        <!-- Password Field -->
                        <StackLayout Spacing="8">
                            <Label Text="Password"
                                   FontFamily="PoppinsSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"/>
                            
                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource LightControlsBackground}, Dark={StaticResource DarkControlsBackground}}"
                                   BorderColor="Transparent"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Entry x:Name="PasswordEntry"
                                           Grid.Column="0"
                                           Text="{Binding Password}"
                                           Placeholder="Enter your password"
                                           IsPassword="{Binding IsPasswordHidden}"
                                           FontFamily="PoppinsRegular"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource LightControlsText}, Dark={StaticResource DarkControlsText}}"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}"
                                           BackgroundColor="Transparent"
                                           ReturnType="Done"
                                           Margin="16,12,0,12"/>
                                    
                                    <Button Grid.Column="1"
                                            Text="{Binding PasswordToggleIcon}"
                                            Command="{Binding TogglePasswordVisibilityCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                            FontSize="16"
                                            Padding="12"
                                            BorderWidth="0"/>
                                </Grid>
                            </Frame>
                        </StackLayout>

                        <!-- Remember Me and Forgot Password -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Remember Me -->
                            <StackLayout Grid.Column="0"
                                       Orientation="Horizontal"
                                       Spacing="8"
                                       VerticalOptions="Center">
                                <CheckBox x:Name="RememberMeCheckBox"
                                        IsChecked="{Binding RememberMe}"
                                        Color="{StaticResource SecondaryButtonLight}"
                                        VerticalOptions="Center"/>
                                <Label Text="Remember me"
                                       FontFamily="PoppinsRegular"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource GameSubtitleLight}, Dark={StaticResource GameSubtitleDark}}"
                                       VerticalOptions="Center"/>
                            </StackLayout>

                            <!-- Forgot Password Link -->
                            <Button Grid.Column="1"
                                    Text="Forgot Password?"
                                    Command="{Binding ForgotPasswordCommand}"
                                    FontFamily="PoppinsRegular"
                                    FontSize="14"
                                    TextColor="{StaticResource SecondaryButtonLight}"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Padding="8,0"
                                    HorizontalOptions="End"/>
                        </Grid>

                        <!-- Error Message -->
                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               FontFamily="PoppinsRegular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight}, Dark={StaticResource ErrorTextDark}}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,0"/>

                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                         IsVisible="{Binding IsLoading}"
                                         Color="{StaticResource SecondaryButtonLight}"
                                         WidthRequest="30"
                                         HeightRequest="30"
                                         HorizontalOptions="Center"
                                         Margin="0,16,0,0"/>

                    </StackLayout>
                </Frame>

                <!-- Action Buttons -->
                <StackLayout Spacing="16">
                    <!-- Login Button -->
                    <Button Text="🔐 Sign In"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource MainPagePrimaryButton}"
                            IsEnabled="{Binding IsNotLoading}"
                            SemanticProperties.Hint="Sign in to your account"/>

                    <!-- Register Button -->
                    <Button Text="👤 Create New Account"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource MainPageSecondaryButton}"
                            IsEnabled="{Binding IsNotLoading}"
                            SemanticProperties.Hint="Create a new user account"/>

                    <!-- Email Verification Link -->
                    <Button Text="📧 Need to verify your email?"
                            Command="{Binding NavigateToVerificationCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource SecondaryButtonLight}"
                            BorderColor="Transparent"
                            FontFamily="PoppinsRegular"
                            FontSize="14"
                            IsEnabled="{Binding IsNotLoading}"
                            SemanticProperties.Hint="Go to email verification page"/>
                </StackLayout>

                <!-- Footer -->
                <StackLayout Spacing="8" Margin="0,24,0,0">
                    <Label Text="Marriage Calculator"
                           FontFamily="PoppinsSemibold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"
                           HorizontalOptions="Center"/>
                    
                    <Label Text="Your favorite card game companion"
                           FontFamily="PoppinsRegular"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource GameSubtitleLight}, Dark={StaticResource GameSubtitleDark}}"
                           HorizontalOptions="Center"
                           Opacity="0.7"/>
                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Email Verification Dialog -->
        <Frame Grid.RowSpan="2"
               IsVisible="{Binding IsVerificationDialogVisible}"
               BackgroundColor="{AppThemeBinding Light=#80000000, Dark=#80000000}"
               BorderColor="Transparent"
               Padding="0"
               HorizontalOptions="Fill"
               VerticalOptions="Fill">
            
            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                <Frame Style="{StaticResource GameCardFrame}"
                       Padding="32,24"
                       WidthRequest="400"
                       MaximumWidthRequest="400"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    
                    <StackLayout Spacing="20">
                        <!-- Header -->
                        <StackLayout Spacing="8">
                            <Label Text="📧 Email Verification"
                                   FontFamily="PoppinsSemibold"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"
                                   HorizontalOptions="Center"/>
                            

                            <Label Text="{Binding VerificationEmail, StringFormat='We sent a verification code to {0}'}"
                                   FontFamily="PoppinsRegular"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource GameSubtitleLight}, Dark={StaticResource GameSubtitleDark}}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </StackLayout>

                        <!-- Verification Code Entry -->
                        <StackLayout Spacing="8">
                            <Label Text="Verification Code"
                                   FontFamily="PoppinsSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"/>
                            
                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource LightControlsBackground}, Dark={StaticResource DarkControlsBackground}}"
                                   BorderColor="Transparent"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False">
                                <Entry x:Name="VerificationCodeEntry"
                                       Text="{Binding VerificationCode}"
                                       Placeholder="Enter 5-digit code"
                                       FontFamily="PoppinsRegular"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource LightControlsText}, Dark={StaticResource DarkControlsText}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}"
                                       BackgroundColor="Transparent"
                                       Keyboard="Numeric"
                                       MaxLength="5"
                                       ReturnType="Done"
                                       HorizontalTextAlignment="Center"
                                       Margin="16,12"/>
                            </Frame>
                        </StackLayout>

                        <!-- Message (Success/Error) -->
                        <Label Text="{Binding VerificationMessage}"
                               IsVisible="{Binding VerificationMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                               FontFamily="PoppinsRegular"
                               FontSize="14"
                               TextColor="{Binding HasVerificationError, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Error|Info'}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsVerificationLoading}"
                                         IsVisible="{Binding IsVerificationLoading}"
                                         Color="{StaticResource SecondaryButtonLight}"
                                         WidthRequest="30"
                                         HeightRequest="30"
                                         HorizontalOptions="Center"/>

                        <!-- Action Buttons -->
                        <StackLayout Spacing="12">
                            <!-- Verify Button -->
                            <Button Text="✅ Verify Email"
                                    Command="{Binding VerifyEmailCommand}"
                                    Style="{StaticResource MainPagePrimaryButton}"
                                    IsEnabled="{Binding IsNotVerificationLoading}"
                                    FontSize="16"/>

                            <!-- Resend Code Button -->
                            <Button Text="📤 Resend Code"
                                    Command="{Binding ResendVerificationCodeCommand}"
                                    Style="{StaticResource MainPageSecondaryButton}"
                                    IsEnabled="{Binding IsNotVerificationLoading}"
                                    FontSize="14"/>

                            <!-- Cancel Button -->
                            <Button Text="❌ Cancel"
                                    Command="{Binding CloseVerificationDialogCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                    BorderColor="Transparent"
                                    FontFamily="PoppinsRegular"
                                    FontSize="14"
                                    IsEnabled="{Binding IsNotVerificationLoading}"/>
                        </StackLayout>

                    </StackLayout>
                </Frame>
            </Grid>
        </Frame>

    </Grid>

</ContentPage>