<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MarriageCalculator.ViewModels"
             
             xmlns:behaviors="clr-namespace:MarriageCalculator.Behaviors"
             x:Class="MarriageCalculator.Pages.MainPage"             
             Shell.NavBarIsVisible="False"
             x:DataType="vm:MainPageViewModel"
             BackgroundColor="DarkBlue">

    <Grid RowSpacing="0" 
          VerticalOptions="Fill" 
          HorizontalOptions="Fill"
          BackgroundColor="#336699">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- TEST: Background image - cards.png should now work -->
        <Image Grid.Row="0" Grid.RowSpan="3"
               Source="cards.png"
               Aspect="AspectFill"
               VerticalOptions="Fill"
               HorizontalOptions="Fill"
               Opacity="0.2"/>

         

        <!-- Game Logo and Header -->
        <StackLayout Grid.Row="0" Spacing="12" Margin="4,4,4,4" BackgroundColor="Transparent">
            
            <!-- User Info and Logout Control - Single Frame -->
            <Frame IsVisible="{Binding IsUserAuthenticated}"
                   CornerRadius="50"
                   BackgroundColor="#F0F0F0"
                   HasShadow="False"
                   HeightRequest="50"
                   HorizontalOptions="Fill"
                   Margin="5,0,5,0">
                
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" HeightRequest="30" VerticalOptions="Center">
                    
                    <!-- Connection Status Dot -->
                    <Ellipse Grid.Column="0"
                             WidthRequest="12"
                             HeightRequest="12"
                             VerticalOptions="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <MultiBinding Converter="{StaticResource ConnectionStatusToColorConverter}">
                                <Binding Path="IsServerConnected"/>
                                <Binding Path="IsConnecting"/>
                            </MultiBinding>
                        </Ellipse.Fill>
                    </Ellipse>
                    
                    <!-- First Partition -->
                    <BoxView Grid.Column="1"
                             WidthRequest="1"
                             BackgroundColor="LightGray"
                             VerticalOptions="Fill"
                             Margin="0,0,8,0" />
                    
                    <!-- User Icon -->
                    <Label Grid.Column="2"
                           Text="👤" 
                           FontSize="18" 
                           VerticalOptions="Center" 
                           TextColor="{StaticResource Black}"
                           Margin="0,0,5,0"/>
                    
                    <!-- Username -->
                    <Label Grid.Column="3"
                           Text="{Binding CurrentUserDisplayName}" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center" 
                           TextColor="{StaticResource Black}"/>

                    <!-- Second Partition -->
                    <BoxView Grid.Column="4"
                             WidthRequest="1"
                             BackgroundColor="LightGray"
                             VerticalOptions="Fill"
                             Margin="10,0" />

                    <!-- Right Side: Logout Button -->
                    <StackLayout Grid.Column="5" 
                                 Orientation="Horizontal" 
                                 VerticalOptions="Center"
                                 IsEnabled="{Binding IsLoggingOut, Converter={StaticResource InvertedBoolConverter}}">
                        
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </StackLayout.GestureRecognizers>
                        
                        <!-- Logout Icon or Loading -->
                        <Grid VerticalOptions="Center">
                            <Label Text="↗" 
                                   FontSize="18" 
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource Black}"
                                   IsVisible="{Binding IsLoggingOut, Converter={StaticResource InvertedBoolConverter}}"/>
                            
                            <ActivityIndicator IsRunning="{Binding IsLoggingOut}"
                                             IsVisible="{Binding IsLoggingOut}"
                                             Color="{StaticResource Black}"
                                             WidthRequest="18"
                                             HeightRequest="18"
                                             VerticalOptions="Center"/>
                        </Grid>
                        
                        <Label Text="Logout" 
                               FontSize="16" 
                               VerticalOptions="Center" 
                               Margin="5,0,0,0"
                               TextColor="{StaticResource Black}"/>
                    </StackLayout>
                </Grid>
            </Frame>
            
            <!-- Game Title and Logo - Enhanced visibility -->
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                <!-- Smaller logo since cards.png is now the background -->
                <Frame BackgroundColor="White" 
                       BorderColor="Transparent" 
                       Padding="8"
                       CornerRadius="15"
                       HorizontalOptions="Center"
                       Opacity="0.9">
                    <Frame.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,4"
                                Radius="12"
                                Opacity="0.3"/>
                    </Frame.Shadow>
                    <Image Source="cards.png"
                           HeightRequest="50"
                           HorizontalOptions="Center"
                           Aspect="AspectFit"/>
                </Frame>

                <!-- Game Title with better contrast -->
                <Label Text="MARRIAGE&#x0A;CALCULATOR"
                       Style="{StaticResource GameTitleLabel}" 
                       TextColor="WhiteSmoke" 
                       FontAttributes="Bold"
                       FontSize="24"
                       Margin="15,0,0,0"
                       VerticalOptions="Center">
                    <Label.Shadow>
                        <Shadow Brush="White"
                                Offset="1,1"
                                Radius="2"
                                Opacity="0.8"/>
                    </Label.Shadow>
                </Label>
            </StackLayout>
            
        </StackLayout>

        <!-- Connection Status Indicator -->
        <StackLayout Grid.Row="1" BackgroundColor="Transparent">
            <!-- Only keep connecting status for initial loading -->
            <Frame Style="{StaticResource ConnectionStatusFrame}"
                   IsVisible="{Binding IsConnecting}"
                   BackgroundColor="#3498DB"
                   Opacity="0.95">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" 
                           Text="🔄" 
                           TextColor="{StaticResource White}"
                           FontSize="16"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <Label Grid.Column="1" 
                           Text="Connecting to Server..." 
                           TextColor="{StaticResource White}"
                           FontFamily="PoppinsSemibold"
                           FontSize="16"
                           VerticalOptions="Center"/>
                    <ActivityIndicator Grid.Column="2"
                                     IsRunning="True"
                                     Color="{StaticResource White}"
                                     WidthRequest="20"
                                     HeightRequest="20"
                                     VerticalOptions="Center"/>
                </Grid>
            </Frame>
        </StackLayout>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="2" BackgroundColor="Transparent">
            <Grid RowDefinitions="*,Auto" MinimumHeightRequest="400">
                
                <!-- Main Content - Takes up most of the space -->
                <StackLayout Grid.Row="0" Spacing="0" Padding="0,24,0,20" BackgroundColor="Transparent" VerticalOptions="FillAndExpand">

                    <!-- Normal Menu when Server is Connected -->
                    <StackLayout Spacing="0" VerticalOptions="FillAndExpand">
                        <StackLayout.IsVisible>
                            <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                <Binding Path="IsServerConnected"/>
                                <Binding Path="IsConnecting" Converter="{StaticResource InvertedBoolConverter}"/>
                            </MultiBinding>
                        </StackLayout.IsVisible>
                        
                        <!-- Game Sets Collection - Expanded to fill most of the screen -->
                        <StackLayout VerticalOptions="FillAndExpand">
                            <!-- Section Header for Game Sets -->
                            <Label Text="Recent Games: Tap to resume game"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   Margin="16,0,16,8"/>
                            
                            <CollectionView ItemsSource="{Binding GameSets}"
                                            VerticalOptions="FillAndExpand"
                                            VerticalScrollBarVisibility="Default">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameSetDetails">
                                        <Frame BackgroundColor="White"
                                               CornerRadius="15"
                                               Margin="16,8"
                                               Padding="16"
                                               HasShadow="True"
                                               Opacity="0.95"
                                               HeightRequest="64">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, Path=SelectGameSetCommand}"
                                                                    CommandParameter="{Binding .}" />
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackLayout Grid.Column="0" Spacing="4">
                                                    <Label Text="{Binding PlayerNames}" 
                                                           FontSize="16" 
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Black}"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding LastPlayed, StringFormat='Last played: {0:MMM dd, yyyy}'}" 
                                                           FontSize="12" 
                                                           TextColor="{StaticResource Gray600}"/>
                                                </StackLayout>
                                                <Label Grid.Column="1" 
                                                       Text="▶" 
                                                       FontSize="18" 
                                                       VerticalOptions="Center"
                                                       TextColor="{StaticResource Primary}"/>
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <StackLayout Padding="16" Spacing="8" VerticalOptions="CenterAndExpand">
                                        <Label Text="No previous games found"
                                               FontSize="16"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               Opacity="0.7"/>
                                        <Label Text="Start a new game to begin playing"
                                               FontSize="14"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               Opacity="0.5"/>
                                    </StackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                            
                            <!-- Simple scroll hint - only show when there are games -->
                            <Label Text="⬆⬇ Scroll for more games"
                                   FontSize="12"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   Opacity="0.6"
                                   Margin="0,4,0,16">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding GameSets.Count}" Value="0">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </StackLayout>
                        
                    </StackLayout>

                    <!-- Enhanced Error State when Server is Not Connected -->
                    <StackLayout Spacing="24"
                                 Margin="24,0"
                                 VerticalOptions="CenterAndExpand">
                        <StackLayout.IsVisible>
                            <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                <Binding Path="IsServerConnected" Converter="{StaticResource InvertedBoolConverter}"/>
                                <Binding Path="IsConnecting" Converter="{StaticResource InvertedBoolConverter}"/>
                            </MultiBinding>
                        </StackLayout.IsVisible>

                        <!-- Error Card -->
                        <Frame BackgroundColor="#3A3A5C"
                               BorderColor="Transparent"
                               CornerRadius="20"
                               Padding="32"
                               HasShadow="True"
                               Opacity="0.95">
                            <Frame.Shadow>
                                <Shadow Brush="#000000"
                                        Offset="0,8"
                                        Radius="16"
                                        Opacity="0.4"/>
                            </Frame.Shadow>
                            <StackLayout Spacing="20">
                                
                                <!-- Error Icon -->
                                <Label Text="🔌"
                                       FontSize="64"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource White}"/>

                                <!-- Error Messages -->
                                <Label Text="Connection Problem"
                                       FontFamily="PoppinsSemibold"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                                
                                <Label Text="We're having trouble connecting to the game server. Please check your internet connection and try again."
                                       FontFamily="PoppinsRegular"
                                       FontSize="16"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Opacity="0.8"/>

                                <!-- Action Buttons with Enhanced Effects -->
                                <StackLayout Spacing="0" Margin="0,20,0,0">
                                    <Button Text="🔄 Try Again"
                                            SemanticProperties.Hint="Retry connection to server"
                                            Style="{StaticResource MainPageRetryButton}"
                                            Command="{Binding RetryConnectionCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                                        <Button.Behaviors>
                                            <behaviors:ButtonAnimationBehavior AnimationType="Rotate" 
                                                                             Duration="400" 
                                                                             ScaleTo="0.95" />
                                            <behaviors:LoadingButtonBehavior IsLoading="{Binding IsConnecting}" 
                                                                           LoadingText="Connecting..." 
                                                                           LoadingAnimationType="Dots" />
                                        </Button.Behaviors>
                                    </Button>

                                    <Button Text="😊 I'll Come Back Later"
                                            SemanticProperties.Hint="Exit the application"
                                            Style="{StaticResource MainPageExitButton}"
                                            Command="{Binding ExitCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                                        <Button.Behaviors>
                                            <behaviors:ButtonAnimationBehavior AnimationType="Glow" 
                                                                             Duration="250" 
                                                                             ScaleTo="0.93" />
                                        </Button.Behaviors>
                                    </Button>
                                </StackLayout>

                            </StackLayout>
                        </Frame>

                    </StackLayout>

                    <!-- Connecting State -->
                    <StackLayout IsVisible="{Binding IsConnecting}" 
                                 Spacing="24"
                                 Margin="24,0"
                                 VerticalOptions="CenterAndExpand">

                        <!-- Connecting Card -->
                        <Frame BackgroundColor="#3A3A5C"
                               BorderColor="Transparent"
                               CornerRadius="20"
                               Padding="32"
                               HasShadow="True"
                               Opacity="0.95">
                            <Frame.Shadow>
                                <Shadow Brush="#000000"
                                        Offset="0,8"
                                        Radius="16"
                                        Opacity="0.4"/>
                            </Frame.Shadow>
                            <StackLayout Spacing="20">
                                
                                <!-- Connecting Icon -->
                                <Label Text="🔄"
                                       FontSize="64"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource White}"/>

                                <!-- Connecting Messages -->
                                <Label Text="Connecting to Server"
                                       FontFamily="PoppinsSemibold"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                                
                                <Label Text="Please wait while we establish connection to the game server..."
                                       FontFamily="PoppinsRegular"
                                       FontSize="16"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Opacity="0.8"/>

                                <!-- Loading Indicator -->
                                <ActivityIndicator IsRunning="True"
                                                 Color="{StaticResource White}"
                                                 WidthRequest="40"
                                                 HeightRequest="40"
                                                 HorizontalOptions="Center"
                                                 Margin="0,10,0,0"/>

                            </StackLayout>
                        </Frame>

                    </StackLayout>

                </StackLayout>
                
                <!-- Primary Action: Start New Game - Fixed at Bottom -->
                <StackLayout Grid.Row="1" Margin="24,0,24,20">
                    <StackLayout.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                            <Binding Path="IsServerConnected"/>
                            <Binding Path="IsConnecting" Converter="{StaticResource InvertedBoolConverter}"/>
                        </MultiBinding>
                    </StackLayout.IsVisible>
                    
                    <Button Text="🚀 Start a New Game"
                            SemanticProperties.Hint="Starts a brand new game"
                            Style="{StaticResource MainPagePrimaryButton}"
                            IsEnabled="{Binding ShowNewGame}"
                            Command="{Binding NewGameCommand}"
                            Opacity="0.95">
                        <Button.Behaviors>
                            <behaviors:ButtonAnimationBehavior AnimationType="Pulse" 
                                                             Duration="250" 
                                                             ScaleTo="0.92" />
                            <behaviors:LoadingButtonBehavior IsLoading="{Binding IsBusy}" 
                                                           LoadingText="Starting Game..." 
                                                           LoadingAnimationType="Spinner" />
                        </Button.Behaviors>
                    </Button>
                </StackLayout>
                
            </Grid>
        </ScrollView>

    </Grid>

</ContentPage>