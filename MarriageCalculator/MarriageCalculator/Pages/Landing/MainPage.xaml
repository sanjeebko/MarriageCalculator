<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MarriageCalculator.ViewModels"
             xmlns:behaviors="clr-namespace:MarriageCalculator.Behaviors"
             x:Class="MarriageCalculator.Pages.MainPage"             
             Shell.NavBarIsVisible="False"
             x:DataType="vm:MainPageViewModel">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Single Seamless Gradient Background -->
        <Rectangle Grid.RowSpan="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow0}, Dark={StaticResource DarkGradientRow0}}" 
                                  Offset="0.0"/>
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow1}, Dark={StaticResource DarkGradientRow1}}" 
                                  Offset="0.4"/>
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow2}, Dark={StaticResource DarkGradientRow2}}" 
                                  Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Game Logo and Header -->
        <StackLayout Grid.Row="0" Spacing="12" Margin="24,40,24,24" BackgroundColor="Transparent">
            
            <!-- User Info and Logout Control - Single Frame -->
            <Frame IsVisible="{Binding IsUserAuthenticated}"
                   CornerRadius="50"
                   BackgroundColor="#F0F0F0"
                   HasShadow="False"
                   HeightRequest="50"
                   HorizontalOptions="FillAndExpand"
                   Margin="5,0,5,0">
                
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" HeightRequest="30" VerticalOptions="Center">
                    
                    <!-- Connection Status Dot -->
                    <Ellipse Grid.Column="0"
                             WidthRequest="12"
                             HeightRequest="12"
                             VerticalOptions="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <MultiBinding Converter="{StaticResource ConnectionStatusToColorConverter}">
                                <Binding Path="IsServerConnected"/>
                                <Binding Path="IsConnecting"/>
                            </MultiBinding>
                        </Ellipse.Fill>
                    </Ellipse>
                    
                    <!-- First Partition -->
                    <BoxView Grid.Column="1"
                             WidthRequest="1"
                             BackgroundColor="LightGray"
                             VerticalOptions="Fill"
                             Margin="0,0,8,0" />
                    
                    <!-- User Icon -->
                    <Label Grid.Column="2"
                           Text="👤" 
                           FontSize="18" 
                           VerticalOptions="Center" 
                           TextColor="{StaticResource Black}"
                           Margin="0,0,5,0"/>
                    
                    <!-- Username -->
                    <Label Grid.Column="3"
                           Text="{Binding CurrentUserDisplayName}" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center" 
                           TextColor="{StaticResource Black}"/>

                    <!-- Second Partition -->
                    <BoxView Grid.Column="4"
                             WidthRequest="1"
                             BackgroundColor="LightGray"
                             VerticalOptions="Fill"
                             Margin="10,0" />

                    <!-- Right Side: Logout Button -->
                    <StackLayout Grid.Column="5" 
                                 Orientation="Horizontal" 
                                 VerticalOptions="Center"
                                 IsEnabled="{Binding IsLoggingOut, Converter={StaticResource InvertedBoolConverter}}">
                        
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </StackLayout.GestureRecognizers>
                        
                        <!-- Logout Icon or Loading -->
                        <Grid VerticalOptions="Center">
                            <Label Text="↗" 
                                   FontSize="18" 
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource Black}"
                                   IsVisible="{Binding IsLoggingOut, Converter={StaticResource InvertedBoolConverter}}"/>
                            
                            <ActivityIndicator IsRunning="{Binding IsLoggingOut}"
                                             IsVisible="{Binding IsLoggingOut}"
                                             Color="{StaticResource Black}"
                                             WidthRequest="18"
                                             HeightRequest="18"
                                             VerticalOptions="Center"/>
                        </Grid>
                        
                        <Label Text="Logout" 
                               FontSize="16" 
                               VerticalOptions="Center" 
                               Margin="5,0,0,0"
                               TextColor="{StaticResource Black}"/>
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Enhanced Game Logo with Shadow -->
            <Frame BackgroundColor="Transparent" 
                   BorderColor="Transparent" 
                   Padding="0"
                   HorizontalOptions="Center">
                <Frame.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,8"
                            Radius="24"
                            Opacity="0.4"/>
                </Frame.Shadow>
                <Image Source="cards.png"
                       HeightRequest="180"
                       HorizontalOptions="Center"
                       Aspect="AspectFit"/>
            </Frame>

            <!-- Game Title Only -->
            <Label Text="Marriage Calculator"
                   Style="{StaticResource GameTitleLabel}"/>
        </StackLayout>

        <!-- Connection Status Indicator - Removed unnecessary message boxes -->
        <StackLayout Grid.Row="1" BackgroundColor="Transparent">
            <!-- Only keep connecting status for initial loading -->
            <Frame Style="{StaticResource ConnectionStatusFrame}"
                   IsVisible="{Binding IsConnecting}"
                   BackgroundColor="#3498DB">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" 
                           Text="🔄" 
                           TextColor="{StaticResource White}"
                           FontSize="16"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <Label Grid.Column="1" 
                           Text="Connecting to Server..." 
                           TextColor="{StaticResource White}"
                           FontFamily="PoppinsSemibold"
                           FontSize="16"
                           VerticalOptions="Center"/>
                    <ActivityIndicator Grid.Column="2"
                                     IsRunning="True"
                                     Color="{StaticResource White}"
                                     WidthRequest="20"
                                     HeightRequest="20"
                                     VerticalOptions="Center"/>
                </Grid>
            </Frame>
        </StackLayout>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="2" BackgroundColor="Transparent">
            <StackLayout Spacing="0" Padding="0,24,0,40" BackgroundColor="Transparent">

                <!-- Normal Menu when Server is Connected -->
                <StackLayout Spacing="0">
                    <StackLayout.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                            <Binding Path="IsServerConnected"/>
                            <Binding Path="IsConnecting" Converter="{StaticResource InvertedBoolConverter}"/>
                        </MultiBinding>
                    </StackLayout.IsVisible>

                    <!-- Primary Action: Start New Game with Enhanced Effects -->
                    <Button Text="🚀 Start a New Game"
                            SemanticProperties.Hint="Starts a brand new game"
                            Style="{StaticResource MainPagePrimaryButton}"
                            IsEnabled="{Binding ShowNewGame}"
                            Command="{Binding NewGameCommand}">
                        <Button.Behaviors>
                            <behaviors:ButtonAnimationBehavior AnimationType="Pulse" 
                                                             Duration="250" 
                                                             ScaleTo="0.92" />
                            <behaviors:LoadingButtonBehavior IsLoading="{Binding IsBusy}" 
                                                           LoadingText="Starting Game..." 
                                                           LoadingAnimationType="Spinner" />
                        </Button.Behaviors>
                    </Button>

                    <!-- Secondary Actions with Different Animation Effects -->
                    <Button Text="📖 Resume Previous Game"
                            SemanticProperties.Hint="Continue your last game"
                            Style="{StaticResource MainPageSecondaryButton}"
                            Command="{Binding ResumeGameCommand}"
                            IsEnabled="{Binding ShowResumeGame}">
                        <Button.Behaviors>
                            <behaviors:ButtonAnimationBehavior AnimationType="Bounce" 
                                                             Duration="200" 
                                                             ScaleTo="0.94" />
                        </Button.Behaviors>
                    </Button>

                    <Button Text="⚙️ Game Settings"
                            SemanticProperties.Hint="Configure game rules and preferences"
                            Style="{StaticResource MainPageSecondaryButton}"
                            Command="{Binding GameSettingsPageCommand}"
                            IsEnabled="{Binding ShowSettings}">
                        <Button.Behaviors>
                            <behaviors:ButtonAnimationBehavior AnimationType="Glow" 
                                                             Duration="180" 
                                                             ScaleTo="0.96" />
                        </Button.Behaviors>
                    </Button>

                    <Button Text="👥 Manage Players"
                            SemanticProperties.Hint="Add, edit, or remove players"
                            Style="{StaticResource MainPageSecondaryButton}"                            
                            Command="{Binding PlayerSettingsPageCommand}">
                        <Button.Behaviors>
                            <behaviors:ButtonAnimationBehavior AnimationType="Flip" 
                                                             Duration="300" 
                                                             ScaleTo="0.95" />
                        </Button.Behaviors>
                    </Button>

                    <!-- Exit Button with Shake Effect -->
                    <Button Text="👋 Exit Game"
                            SemanticProperties.Hint="Close the application"
                            Style="{StaticResource MainPageExitButton}"
                            Command="{Binding ExitCommand}"
                            Margin="16,24,16,8">
                        <Button.Behaviors>
                            <behaviors:ButtonAnimationBehavior AnimationType="Shake" 
                                                             Duration="300" 
                                                             ScaleTo="0.93" />
                        </Button.Behaviors>
                    </Button>

                </StackLayout>

                <!-- Enhanced Error State when Server is Not Connected -->
                <StackLayout Spacing="24"
                             Margin="24,0">
                    <StackLayout.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                            <Binding Path="IsServerConnected" Converter="{StaticResource InvertedBoolConverter}"/>
                            <Binding Path="IsConnecting" Converter="{StaticResource InvertedBoolConverter}"/>
                        </MultiBinding>
                    </StackLayout.IsVisible>

                    <!-- Error Card -->
                    <Frame BackgroundColor="#3A3A5C"
                           BorderColor="Transparent"
                           CornerRadius="20"
                           Padding="32"
                           HasShadow="True">
                        <Frame.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,8"
                                    Radius="16"
                                    Opacity="0.3"/>
                        </Frame.Shadow>
                        <StackLayout Spacing="20">
                            
                            <!-- Error Icon -->
                            <Label Text="🔌"
                                   FontSize="64"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource White}"/>

                            <!-- Error Messages -->
                            <Label Text="Connection Problem"
                                   FontFamily="PoppinsSemibold"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                            
                            <Label Text="We're having trouble connecting to the game server. Please check your internet connection and try again."
                                   FontFamily="PoppinsRegular"
                                   FontSize="16"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   Opacity="0.8"/>

                            <!-- Action Buttons with Enhanced Effects -->
                            <StackLayout Spacing="0" Margin="0,20,0,0">
                                <Button Text="🔄 Try Again"
                                        SemanticProperties.Hint="Retry connection to server"
                                        Style="{StaticResource MainPageRetryButton}"
                                        Command="{Binding RetryConnectionCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                                    <Button.Behaviors>
                                        <behaviors:ButtonAnimationBehavior AnimationType="Rotate" 
                                                                         Duration="400" 
                                                                         ScaleTo="0.95" />
                                        <behaviors:LoadingButtonBehavior IsLoading="{Binding IsConnecting}" 
                                                                       LoadingText="Connecting..." 
                                                                       LoadingAnimationType="Dots" />
                                    </Button.Behaviors>
                                </Button>

                                <Button Text="😊 I'll Come Back Later"
                                        SemanticProperties.Hint="Exit the application"
                                        Style="{StaticResource MainPageExitButton}"
                                        Command="{Binding ExitCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                                    <Button.Behaviors>
                                        <behaviors:ButtonAnimationBehavior AnimationType="Glow" 
                                                                         Duration="250" 
                                                                         ScaleTo="0.93" />
                                    </Button.Behaviors>
                                </Button>
                            </StackLayout>

                        </StackLayout>
                    </Frame>

                </StackLayout>

                <!-- Connecting State -->
                <StackLayout IsVisible="{Binding IsConnecting}" 
                             Spacing="24"
                             Margin="24,0">

                    <!-- Connecting Card -->
                    <Frame BackgroundColor="#3A3A5C"
                           BorderColor="Transparent"
                           CornerRadius="20"
                           Padding="32"
                           HasShadow="True">
                        <Frame.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,8"
                                    Radius="16"
                                    Opacity="0.3"/>
                        </Frame.Shadow>
                        <StackLayout Spacing="20">
                            
                            <!-- Connecting Icon -->
                            <Label Text="🔄"
                                   FontSize="64"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource White}"/>

                            <!-- Connecting Messages -->
                            <Label Text="Connecting to Server"
                                   FontFamily="PoppinsSemibold"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                            
                            <Label Text="Please wait while we establish connection to the game server..."
                                   FontFamily="PoppinsRegular"
                                   FontSize="16"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   Opacity="0.8"/>

                            <!-- Loading Indicator -->
                            <ActivityIndicator IsRunning="True"
                                             Color="{StaticResource White}"
                                             WidthRequest="40"
                                             HeightRequest="40"
                                             HorizontalOptions="Center"
                                             Margin="0,10,0,0"/>

                        </StackLayout>
                    </Frame>

                </StackLayout>

            </StackLayout>
        </ScrollView>

    </Grid>

</ContentPage>