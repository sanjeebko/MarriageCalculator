<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MarriageCalculator.Pages.GameSetupPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MarriageCalculator.ViewModels"
             xmlns:behaviors="clr-namespace:MarriageCalculator.Behaviors"
             xmlns:models="clr-namespace:MarriageCalculator.Core.Models;assembly=MarriageCalculator.Core"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             x:DataType="viewmodels:GameSetupViewModel"
             xmlns:local="clr-namespace:MarriageCalculator.Converter"
             Shell.NavBarIsVisible="False"
             Title="Game Setup">
    <ContentPage.Resources>
        <local:DataGridColorConverter x:Key="converter"/>
        <Style TargetType="syncfusion:DataGridRow">
            <Setter Property="Background" Value="{Binding Converter={StaticResource converter}}" />
        </Style>
    </ContentPage.Resources>
    
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Seamless Gradient Background -->
        <Rectangle Grid.RowSpan="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow0}, Dark={StaticResource DarkGradientRow0}}" Offset="0.0"/>
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow1}, Dark={StaticResource DarkGradientRow1}}" Offset="0.4"/>
                    <GradientStop Color="{AppThemeBinding Light={StaticResource LightGradientRow2}, Dark={StaticResource DarkGradientRow2}}" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Header Section - Enhanced User Info Frame (Similar to MainPage) -->
        <StackLayout Grid.Row="0" Spacing="12" Margin="4,4,4,4" BackgroundColor="Transparent">

            <!-- User Info and Game Setup Control - Single Frame -->
            <Frame IsVisible="True"
                   CornerRadius="50"
                   BackgroundColor="#F0F0F0"
                   HasShadow="False" 
                   HorizontalOptions="Fill"
                   Margin="5,0,5,0">

                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" VerticalOptions="Center">

                    <!-- Player Status Dot -->
                    <Ellipse Grid.Column="0"
                             WidthRequest="12"
                             HeightRequest="12"
                             VerticalOptions="Center"
                             Fill="{Binding PlayerStatusColor}"
                             Margin="0,0,8,0"/>

                    <!-- First Partition -->
                    <BoxView Grid.Column="1"
                             WidthRequest="1"
                             BackgroundColor="LightGray"
                             VerticalOptions="Fill"
                             Margin="0,0,8,0" />

                    <!-- Game Setup Title -->
                    <Label Grid.Column="2"
                           Text="Marriage Round" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center" 
                           TextColor="{StaticResource Black}"/>

                    <!-- Second Partition -->
                    <BoxView Grid.Column="4"
                             WidthRequest="1"
                             BackgroundColor="LightGray"
                             VerticalOptions="Fill"
                             Margin="10,0" />

                    <!-- Header Action Buttons -->
                    <StackLayout Grid.Column="5" 
                                 Orientation="Horizontal" 
                                 VerticalOptions="Center"
                                 Spacing="8">

                        <!-- Game Settings Button -->
                        <Label Text="⚙️" 
                               FontSize="18" 
                               VerticalOptions="Center"
                               TextColor="{StaticResource Black}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GameSettingsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Manage Players Button -->
                        <Label Text="👥" 
                               FontSize="18" 
                               VerticalOptions="Center"
                               TextColor="{StaticResource Black}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ManagePlayersCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <!-- Back Button -->
                        <Label Text="🔙" 
                               FontSize="18" 
                               VerticalOptions="Center"
                               TextColor="{StaticResource Black}" >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                </Grid>
            </Frame>
            <!-- Player Status -->
            <Frame Style="{StaticResource GameCardFrame}" 
                    Padding="15,10" Margin="5,0,5,0">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <!-- Header Row: Status Dot + Title -->
                    <Label Grid.Row="0" Grid.Column="1"
                   Text="👥 Selected Players"
                   FontFamily="PoppinsSemibold"
                   FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"
                   VerticalOptions="Center" HorizontalOptions="Center" />
                    <!-- Players CollectionView Row -->
                    <CollectionView Grid.Row="1"
                        ItemsSource="{Binding SelectedPlayers}"
                        VerticalOptions="Fill"
                        HeightRequest="70"
                        BackgroundColor="Transparent">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                               Span="2"
                               HorizontalItemSpacing="4"
                               VerticalItemSpacing="2"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Player">
                                <Frame BackgroundColor="Transparent"
                           BorderColor="Transparent"
                           Padding="6,2"
                           HasShadow="False">
                                    <Label Text="{Binding Name, Converter={StaticResource FirstCharUpperConverter}}"
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               LineBreakMode="TailTruncation"/>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4" Padding="12">
                                <Label Text="🎭 No players selected"
                           FontFamily="PoppinsRegular"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"
                           HorizontalOptions="Center"
                           Opacity="0.8"/>
                                <Label Text="Please select players to start game"
                           FontFamily="PoppinsRegular"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"
                           Opacity="0.6"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Grid>
            </Frame>
        </StackLayout>
        <!-- Main Content Area -->
        <ScrollView Grid.Row="1" BackgroundColor="Transparent" >
            <StackLayout Spacing="12"   BackgroundColor="Transparent" Margin="4,4,4,4" >
                <!-- Game Round - Professional DataGrid with Active/Completed Visual States -->

                <StackLayout Orientation="Vertical">
                    <CollectionView x:Name="RoundCollectionView"
                                         ItemsSource="{Binding MarriageGamesGrouped}"
                                         IsGrouped="True"
                                         >
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate x:DataType="viewmodels:MarriageGameGroup">
                                <StackLayout BackgroundColor="LightGray" Padding="10,5">
                                    <Label Text="{Binding RoundId, StringFormat='Round {0}'}" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="DarkBlue"/>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:MarriageRoundAndGamesModel">
                                 
                                <Frame Style="{StaticResource GameCardFrame}" Padding="15,10" Margin="5,0,5,0">
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding PlayerName}" Value="-">
                                            <Setter Property="BackgroundColor" Value="#F0FFF0" />
                                        </DataTrigger>
                                    </Frame.Triggers>
                                    <StackLayout Orientation="Horizontal" Padding="10" Spacing="20">
                                        <Label Text="{Binding Sequence}" FontSize="10" TextColor="Green"/>
                                        <Label Text="{Binding Date, StringFormat='{0:dd/MM/yy HH:mm}'}" FontSize="10" TextColor="Green"/>
                                        <Label Text="Winner:" FontSize="10" TextColor="Red"/>
                                        <Label Text="{Binding PlayerName}" FontSize="10" TextColor="Red"/>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView> 
                </StackLayout>





                

            </StackLayout>
        </ScrollView>
        <!-- Action Buttons -->
        <StackLayout Spacing="16" Grid.Row="2">

            <!-- Start/Resume Game Button -->
            <Button x:Name="StartGameButton"
            Text="🎮 Start Game"
            Command="{Binding ReadyCommand}"
            Style="{StaticResource MainPagePrimaryButton}"                             
            SemanticProperties.Hint="Start or resume the game">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsNewGame}" Value="True">
                        <Setter Property="Text" Value="🎮 Start New Game" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsNewGame}" Value="False">
                        <Setter Property="Text" Value="▶️ Resume Game" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>





        </StackLayout>
        <!-- Loading Overlay -->
        <Frame Grid.RowSpan="3"
               IsVisible="{Binding IsBusy}"
               BackgroundColor="{AppThemeBinding Light=#80000000, Dark=#80000000}"
               BorderColor="Transparent"
               Padding="0"
               HorizontalOptions="Fill"
               VerticalOptions="Fill">

            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                <Frame Style="{StaticResource GameCardFrame}"
                       Padding="32,24"
                       WidthRequest="300"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">

                    <StackLayout Spacing="20" HorizontalOptions="Center">
                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                         Color="{StaticResource SecondaryButtonLight}"
                                         WidthRequest="40"
                                         HeightRequest="40"
                                         HorizontalOptions="Center"/>

                        <!-- Loading Text -->
                        <Label Text="Setting up game..."
                               FontFamily="PoppinsSemibold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource GameTitleLight}, Dark={StaticResource GameTitleDark}}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Frame>
            </Grid>
        </Frame>

    </Grid>
</ContentPage>