<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MarriageCalculator"
             xmlns:converters="clr-namespace:MarriageCalculator.Converter"
             x:Class="MarriageCalculator.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:SelectedPlayerConverter x:Key="SelectedPlayerConverter" />
            <converters:PlayerSelectionStatusConverter x:Key="PlayerSelectionStatusConverter" />
            <converters:PlayerInActivePlayersMultiConverter x:Key="PlayerInActivePlayersMultiConverter" />
            <converters:SimplePlayerSelectionConverter x:Key="SimplePlayerSelectionConverter" />
            <converters:PlayerNameInListConverter x:Key="PlayerNameInListConverter" />
            <converters:DirectPlayerBackgroundConverter x:Key="DirectPlayerBackgroundConverter" />
            <converters:FirstCharUpperConverter x:Key="FirstCharUpperConverter" />
            <converters:CurrencyToDescriptionConverter x:Key="CurrencyToDescriptionConverter" />
            <converters:FoulPointBonusTypeToDescriptionConverter x:Key="FoulPointBonusTypeToDescriptionConverter" />
            <converters:AllTrueConverter x:Key="AllTrueConverter" />
            <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
            <converters:ConnectionStatusToColorConverter x:Key="ConnectionStatusToColorConverter" />
        </ResourceDictionary>
        
    </Application.Resources>
</Application>
