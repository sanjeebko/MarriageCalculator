# Keystore configuration template for Release Signing
# Copy this file to 'keystore.properties' (in the MarriageCalculator/Android directory)
# and fill in your actual upload key details.
# DO NOT commit your real 'keystore.properties' or keystore (.jks/.keystore) files to git!

storeFile=upload-keystore.jks
storePassword=your_keystore_password
keyAlias=upload-key-alias
keyPassword=your_key_password
